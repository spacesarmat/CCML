 .inspector-duration { margin-top: 5px; display: block; color: #93a4b8; font-size: 8px; font-variant-numeric: tabular-nums; }
-.inspector-player { min-width: 0; min-height: 34px; display: flex; align-items: center; }
-.inspector-player audio { width: 100%; height: 32px; display: block; }
+.inspector-player { min-width: 0; min-height: 36px; display: flex; align-items: center; }
 .inspector-player > span { width: 100%; padding: 7px 9px; border: 1px solid #273548; border-radius: 7px; background: #0b1119; color: #788ba3; font-size: 8px; text-align: center; }
 .inspector-player .media-error { color: #c98186; border-color: #573338; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
+.inspector-player-ready { width: 100%; min-width: 0; }
+.inspector-player-ready audio { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
+.inspector-player-controls { min-width: 0; display: grid; grid-template-columns: 28px 32px minmax(64px, 1fr) 32px 48px; gap: 6px; align-items: center; padding: 5px 6px; border: 1px solid #273548; border-radius: 8px; background: #0b1119; }
+.inspector-player-controls .player-toggle { width: 28px; height: 26px; padding: 0; display: grid; place-items: center; border-color: #354860; border-radius: 6px; color: #dce5f0; font-size: 10px; line-height: 1; }
+.inspector-player-controls .player-time { color: #92a2b7; font-size: 8px; font-variant-numeric: tabular-nums; text-align: center; }
+.inspector-player-controls input[type="range"] { min-width: 0; width: 100%; height: 18px; margin: 0; padding: 0; accent-color: #6b86ff; cursor: pointer; }
+.inspector-player-controls input[type="range"]:disabled { cursor: default; opacity: .45; }
+.inspector-player-controls .player-volume { width: 48px; }
+.player-preview-badge { grid-column: 1 / -1; justify-self: end; margin-top: -2px; color: #7f91aa; font-size: 7px; letter-spacing: .03em; }
 
 .spectrogram-section { display: grid; gap: 7px; padding-top: 8px; border-top: 1px solid #202a38; }
